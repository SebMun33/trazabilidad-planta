# /etc/trazabilidad-planta/planta.env (dueño root, grupo trazabilidad, permisos 640).
# Configuración de la PC de planta. Ver docs/instalacion_ubuntu.md.

DJANGO_SETTINGS_MODULE=config.settings.prod_planta
DJANGO_SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria

# Base central (Neon), conexión directa con el rol app_planta.
DATABASE_URL=postgres://app_planta:CLAVE@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require
DB_CONN_MAX_AGE=0

# Kiosco
PLANTA_DISPOSITIVO=kiosco-planta
KIOSCO_DB=/var/lib/trazabilidad-planta/kiosco.sqlite3

# Backup diario (deploy/planta/backup.sh)
BACKUP_DIR=/var/backups/trazabilidad-planta
BACKUP_DIAS=30
# Copia fuera de la planta por FTP con TLS (p. ej., el hosting de DonWeb). Opcional.
# BACKUP_FTP_HOST=ftp.midominio.com.ar
# BACKUP_FTP_USUARIO=usuario
# BACKUP_FTP_CLAVE=clave
# BACKUP_FTP_DIR=/backups/trazabilidad-planta
