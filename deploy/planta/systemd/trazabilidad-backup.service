[Unit]
Description=Trazabilidad de planta: backup diario (base central y copia del kiosco)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=trazabilidad
Group=trazabilidad
WorkingDirectory=/opt/trazabilidad-planta
EnvironmentFile=/etc/trazabilidad-planta/planta.env
ExecStart=/opt/trazabilidad-planta/deploy/planta/backup.sh

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/trazabilidad-planta
