[Unit]
Description=Trazabilidad de planta: kiosco (Gunicorn en 127.0.0.1:8000)
After=network.target

[Service]
Type=simple
User=trazabilidad
Group=trazabilidad
WorkingDirectory=/opt/trazabilidad-planta
EnvironmentFile=/etc/trazabilidad-planta/planta.env
# Solo escucha en la propia PC: el kiosco no se publica en la red.
ExecStart=/opt/trazabilidad-planta/.venv/bin/gunicorn config.wsgi:application \
    --bind 127.0.0.1:8000 --workers 2 --timeout 30 --access-logfile -
Restart=always
RestartSec=3

# Endurecimiento
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/trazabilidad-planta

[Install]
WantedBy=multi-user.target
