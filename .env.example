# Copiar a `.env` y completar. Nunca subir `.env` al repo.

# --- Django ---------------------------------------------------------------
DJANGO_SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_CSRF_TRUSTED_ORIGINS=
# Settings: config.settings.dev | test | prod_oficina | prod_planta
DJANGO_SETTINGS_MODULE=config.settings.dev

# --- Base de datos ---------------------------------------------------------
# Desarrollo local con `docker compose up -d` (credenciales solo locales):
#   app en ejecución -> rol app_planta (sin UPDATE/DELETE en planta)
#   migraciones/seed -> rol app_planta_owner (ver ops/migrar.sh)
DATABASE_URL=postgres://app_planta:app_local@localhost:5432/planta
DATABASE_URL_OWNER=postgres://app_planta_owner:owner_local@localhost:5432/planta
# Neon (rama dev-planta), conexión directa (sin "-pooler") y sslmode=require:
# DATABASE_URL=postgres://app_planta:<pw>@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require
# DATABASE_URL_OWNER=postgres://app_planta_owner:<pw>@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require
DB_CONNECT_TIMEOUT=10

# Tests: SIEMPRE contra Postgres local (nunca Neon). Si no se define, usa el de docker compose.
# TEST_DATABASE_URL=postgres://app_planta_owner:owner_local@localhost:5432/planta
# Tests de permisos: contraseña del rol app_planta en el Postgres de tests.
TEST_APP_PLANTA_PASSWORD=app_local

# --- Planta -----------------------------------------------------------------
PLANTA_DISPOSITIVO=desarrollo
